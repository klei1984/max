# Maintainer: M.A.X. Port Team <maxport@maxport.org>
pkgname="max-port"
pkgver=0.8.0
pkgrel=1
pkgdesc="conquer and plunder-type turn-based sci-fi strategy game"
arch=("${CARCH}")
url="https://github.com/klei1984/max"
license=("MIT")
depends=("glibc" "gcc-libs")
makedepends=("git" "cmake" "gcc" "ninja" "wget" "gettext" "p7zip" "libx11" "libxext" "libxcursor" "libxrandr" "libxfixes" "libxi" "libxss" "libxtst" "libxkbcommon" "wayland" "wayland-protocols" "libdecor" "alsa-lib" "libpulse" "dbus" "libglvnd")
source=("$pkgname::git+https://github.com/klei1984/max.git")
provides=("$pkgname")
conflicts=("$pkgname")
sha256sums=("SKIP")

pkgver() {
    cd "$pkgname"
    _v=$(git describe --long --tags --abbrev=8 --exclude="*[a-zA-Z][a-zA-Z]*" 2>/dev/null | sed -E "s/^[^0-9]*//;s/([^-]*-g)/r\1/;s/-/./g")
    [ -n "$_v" ] || _v="$pkgver.r$(git rev-list --count HEAD).g$(git rev-parse --short=8 HEAD)"
    printf '%s' "$_v"
}

build() {
    cd "${srcdir}/${pkgname}"
        DESTDIR=$pkgdir cmake --no-warn-unused-cli -Wno-dev -G "Ninja" \
        -DCMAKE_TOOLCHAIN_FILE=./cmake/toolchain-linux-${CARCH}.cmake \
        -DMAXPORT_PKGMAKE_BUILD=TRUE \
        -DCMAKE_BUILD_TYPE=None \
        -DBUILD_SHARED_LIBS=ON \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -S . -B build
    cmake --build build --parallel
}

package() {
    cd "${srcdir}/${pkgname}"
    DESTDIR="$pkgdir" cmake --install build
    install -Dm644 LICENSE -t "${pkgdir}/usr/share/licenses/${pkgname}"
    depends=("${depends[@]/glibc/glibc>=$(pacman -Q glibc | awk '{print $2}' | cut -d- -f1 | cut -d+ -f1)}")
    depends=("${depends[@]/gcc-libs/gcc-libs>=$(pacman -Q gcc-libs | awk '{print $2}' | cut -d- -f1 | cut -d+ -f1)}")
}
